{
  "name": "nutritional-zscore-calculator",
  "version": "5.7.0",
  "private": true,
  "description": "Calcul de croissance OMS local-first FR/EN/AR, sans compte ni dependance reseau du moteur",
  "scripts": {
    "build:release": "node tools/scripts/build-release.cjs",
    "check:release": "node tools/scripts/build-release.cjs --check",
    "prepare:public": "node tools/scripts/prepare-public.cjs",
    "prestart": "node tools/scripts/build-release.cjs --check",
    "start": "node tools/scripts/serve.cjs",
    "test": "node tools/scripts/test-public.cjs",
    "audit:clinical": "node tools/scripts/clinical-audit.cjs",
    "audit:licenses": "node tools/scripts/audit-licenses.cjs",
    "verify:public": "node tools/verification/verify.cjs",
    "test:private": "node tools/scripts/test-public.cjs --private",
    "check:public": "node tools/scripts/check-public-files.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5"
  }
}
